#!/bin/bash
set -euo pipefail
umask 077
[[ -f /var/lib/razumist/razumist.sqlite3 ]] || exit 0
mkdir -p /var/backups/razumist
python3 - <<'PY'
import sqlite3, pathlib, datetime
out=pathlib.Path('/var/backups/razumist')
name=datetime.datetime.now(datetime.timezone.utc).strftime('%Y%m%dT%H%M%S%fZ.sqlite3')
with sqlite3.connect('file:/var/lib/razumist/razumist.sqlite3?mode=ro',uri=True) as src, sqlite3.connect(out/name) as dst:
    src.backup(dst)
# Keep the 14 newest project backups. No files outside this dedicated directory.
for p in sorted(out.glob('*.sqlite3'),reverse=True)[14:]: p.unlink()
PY
